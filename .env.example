NODE_ENV=development
# Usado pelo servidor local; Vercel fornece PORT automaticamente quando aplicável.
PORT=3000
# Em produção, gere uma chave longa e aleatória e mantenha-a fora do código.
JWT_SECRET=
# Connection string PostgreSQL pooled do Neon (não use em código público).
DATABASE_URL=
# Token de leitura/escrita da store privada do Vercel Blob; mantenha-o secreto.
BLOB_READ_WRITE_TOKEN=
# Máximo de conexões por instância serverless; use a URL pooled do Neon.
PG_POOL_MAX=5
# OneSignal: App ID público e REST API Key secreta. O App ID também é usado
# como GitHub Actions Variable ONESIGNAL_APP_ID para o frontend do Pages.
# App ID e Safari Web ID são identificadores públicos fornecidos pelo OneSignal.
ONESIGNAL_APP_ID=46bd790b-9f2c-4932-86d0-7a4a0a942275
ONESIGNAL_REST_API_KEY=
# URL de abertura das notificações push.
DABRIK_SITE_URL=https://llc-afk.github.io/Dabrik/
# Origens dos sites que podem chamar a API (separadas por vírgula).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://llc-afk.github.io
# DABRIK_API_BASE_URL e uma variável pública do build do GitHub Pages;
# configure-a nas Actions Variables com a origem HTTPS da API, sem /api.
